//kage:unit pixels
package main

var RenderFood int

const pherShift = 5 //(2^13 = 8192), meaning 8192 is within 13 bits range, We want to shift that to 8 bits, so shift 5 out.

const (
	e_none = 0
	e_home = 1
	e_wall = 2
)

const (
	FoodNone = 0
	FoodN    = 0b1
	FoodNE   = 0b10
	FoodE    = 0b100               //1 << 2
	FoodSE   = 0b1000              //1 << 3
	FoodS    = 0b10000             //1 << 4
	FoodSW   = 0b100000            //1 << 5
	FoodW    = 0b1000000           //1 << 6
	FoodNW   = 0b10000000          //1 << 7
	HomeNone = 0b100000000         //1 << 8
	HomeN    = 0b1000000000        //1 << 9
	HomeNE   = 0b10000000000       //1 << 10
	HomeE    = 0b100000000000      //1 << 11
	HomeSE   = 0b1000000000000     //1 << 12
	HomeS    = 0b10000000000000    //1 << 13
	HomeSW   = 0b100000000000000   //1 << 14
	HomeW    = 0b1000000000000000  //1 << 15
	HomeNW   = 0b10000000000000000 //1 << 16
)

// Decodes a vec4 RGBA into a uint32
func ToUint32(v vec4) int {
	return (int(v.a*255) << 24) |
		(int(v.b*255) << 16) |
		(int(v.g*255) << 8) |
		int(v.r*255)
}

// Encodes a uint32 into a vec4 RGBA
func FromUint32(i int) vec4 {
	return vec4(
		float(i&0xFF)/255,
		float((i>>8)&0xFF)/255,
		float((i>>16)&0xFF)/255,
		float((i>>24)&0xFF)/255,
	)
}

func Fragment(targetCoords vec4, sourceCoords vec2, _ vec4) vec4 {
	i := ToUint32(imageSrc0At(sourceCoords))
	if RenderFood > 0 {
		if i&FoodN > 0 {
			return vec4(1, 0, 0, 1)
		}
		if i&FoodNE > 0 {
			return vec4(0, 1, 0, 1)
		}
		if i&FoodE > 0 {
			return vec4(0, 0, 1, 1)
		}
		if i&FoodSE > 0 {
			return vec4(1, 1, 0, 1)
		}
		if i&FoodS > 0 {
			return vec4(0, 1, 1, 1)
		}
		if i&FoodSW > 0 {
			return vec4(1, 1, 1, 1)
		}
		if i&FoodW > 0 {
			return vec4(0, 0, 0, 1)
		}
		if i&FoodNW > 0 {
			return vec4(0.5, 0.5, 0.5, 1)
		}
	} else {
		if i&HomeN > 0 {
			return vec4(1, 0, 0, 1)
		}
		if i&HomeNE > 0 {
			return vec4(1, 1, 0, 1)
		}
		if i&HomeE > 0 {
			return vec4(0, 1, 0, 1)
		}
		if i&HomeSE > 0 {
			return vec4(0, 1, 1, 1)
		}
		if i&HomeS > 0 {
			return vec4(0, 0, 1, 1)
		}
		if i&HomeSW > 0 {
			return vec4(0.5, 0, 1, 1)
		}
		if i&HomeW > 0 {
			return vec4(0.5, 0, 0.5, 1)
		}
		if i&HomeNW > 0 {
			return vec4(1, 0, 0.5, 1)
		}
	}
	return vec4(0, 0, 0, 0)
}
