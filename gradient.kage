//kage:unit pixels
package main

const pherShift = 5 //(2^13 = 8192), meaning 8192 is within 13 bits range, We want to shift that to 8 bits, so shift 5 out.

const (
	e_none = 0
	e_home = 1
	e_wall = 2
)

const (
	FoodNone = 0
	FoodN    = 0b1
	FoodNE   = 0b10
	FoodE    = 0b100               //1 << 2
	FoodSE   = 0b1000              //1 << 3
	FoodS    = 0b10000             //1 << 4
	FoodSW   = 0b100000            //1 << 5
	FoodW    = 0b1000000           //1 << 6
	FoodNW   = 0b10000000          //1 << 7
	HomeNone = 0b100000000         //1 << 8
	HomeN    = 0b1000000000        //1 << 9
	HomeNE   = 0b10000000000       //1 << 10
	HomeE    = 0b100000000000      //1 << 11
	HomeSE   = 0b1000000000000     //1 << 12
	HomeS    = 0b10000000000000    //1 << 13
	HomeSW   = 0b100000000000000   //1 << 14
	HomeW    = 0b1000000000000000  //1 << 15
	HomeNW   = 0b10000000000000000 //1 << 16
)

// Decodes a vec4 RGBA into a uint32
func ToUint32(v vec4) int {
	return (int(v.a*255) << 24) |
		(int(v.b*255) << 16) |
		(int(v.g*255) << 8) |
		int(v.r*255)
}

// Encodes a uint32 into a vec4 RGBA
func FromUint32(i int) vec4 {
	return vec4(
		float(i&0xFF)/255,
		float((i>>8)&0xFF)/255,
		float((i>>16)&0xFF)/255,
		float((i>>24)&0xFF)/255,
	)
}

func Fragment(targetCoords vec4, sourceCoords vec2, _ vec4) vec4 {
	//return vec4(1, 0, 0, 1)

	// food := imageSrc2At(sourceCoords)
	// foodpresent := food.r+food.b+food.g+food.a > 0

	// hwim := imageSrc3At(sourceCoords)
	// hwenum := int(hwim.r * 255)
	// // if hwenum == e_wall {
	// // 	return vec4(0.2, 0.2, 0.2, 1)
	// // } else if hwenum == e_home {
	// // 	return vec4(1, 0.2, 0.2, 1)
	// // }

	// foodi := ToUint32(imageSrc0At(sourceCoords))
	// homei := ToUint32(imageSrc1At(sourceCoords))

	// resi := int(0)
	//foodset := false
	//homeset := true
	nfood := int(0)
	nefood := int(0)
	efood := int(0)
	sefood := int(0)
	sfood := int(0)
	swfood := int(0)
	wfood := int(0)
	nwfood := int(0)

	nhome := int(0)
	nehome := int(0)
	ehome := int(0)
	sehome := int(0)
	shome := int(0)
	swhome := int(0)
	whome := int(0)
	nwhome := int(0)

	// North
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x, sourceCoords.y-1)
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			nfood += 10000
		}

		if hwenum == e_home {
			nhome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		nfood += foodi
		nhome += homei
	}
	// North East
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x+1+float(i), sourceCoords.y-1-float(i))
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			nefood += 10000
		}

		if hwenum == e_home {
			nehome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		nefood += foodi
		nehome += homei
	}
	// East
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x+1+float(i), sourceCoords.y)
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			efood += 10000
		}

		if hwenum == e_home {
			ehome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		efood += foodi
		ehome += homei
	}
	// South East
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x+1+float(i), sourceCoords.y+1+float(i))
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			sefood += 10000
		}

		if hwenum == e_home {
			sehome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		sefood += foodi
		sehome += homei
	}
	// South
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x, sourceCoords.y+1+float(i))
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			sfood += 10000
		}

		if hwenum == e_home {
			shome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		sfood += foodi
		shome += homei
	}
	// South West
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x-1-float(i), sourceCoords.y+1+float(i))
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			swfood += 10000
		}

		if hwenum == e_home {
			swhome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		swfood += foodi
		swhome += homei
	}
	// West
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x-1-float(i), sourceCoords.y)
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			wfood += 10000
		}

		if hwenum == e_home {
			whome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		wfood += foodi
		whome += homei
	}
	// North West
	for i := 0; i < 15; i++ {
		c := vec2(sourceCoords.x-1-float(i), sourceCoords.y-1-float(i))
		food := imageSrc2At(c)
		hwenum := int(imageSrc3At(sourceCoords).r * 255)
		if hwenum == e_wall {
			// scan ran into a wall. Stop.
			break
		}

		if food.r+food.b+food.g+food.a > 0 {
			nwfood += 10000
		}

		if hwenum == e_home {
			nwhome += 10000
		}

		foodi := ToUint32(imageSrc0At(c))
		homei := ToUint32(imageSrc1At(c))
		nwfood += foodi
		nwhome += homei
	}
	ftgt := FoodNone
	fval := 0
	htgt := HomeNone
	hval := 0
	if nfood > 0 {
		ftgt = FoodN
		fval = nfood
	}
	if nefood > fval {
		ftgt = FoodNE
		fval = nefood
	}
	if efood > fval {
		ftgt = FoodE
		fval = efood
	}
	if sefood > fval {
		ftgt = FoodSE
		fval = sefood
	}
	if sfood > fval {
		ftgt = FoodS
		fval = sfood
	}
	if swfood > fval {
		ftgt = FoodSW
		fval = swfood
	}
	if wfood > fval {
		ftgt = FoodW
		fval = wfood
	}
	if nwfood > fval {
		ftgt = FoodNW
		fval = nwfood
	}

	if nhome > 0 {
		htgt = HomeN
		hval = nhome
	}
	if nehome > hval {
		htgt = HomeNE
		hval = nehome
	}
	if ehome > hval {
		htgt = HomeE
		hval = ehome
	}
	if sehome > hval {
		htgt = HomeSE
		hval = sehome
	}
	if shome > hval {
		htgt = HomeS
		hval = shome
	}
	if swhome > hval {
		htgt = HomeSW
		hval = swhome
	}
	if whome > hval {
		htgt = HomeW
		hval = whome
	}
	if nwhome > hval {
		htgt = HomeNW
		hval = nwhome
	}

	ri := ftgt | htgt
	return FromUint32(ri)
}
